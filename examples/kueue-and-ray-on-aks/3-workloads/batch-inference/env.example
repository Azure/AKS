# batch-inference environment variables.
# Requires a completed llm-training job (Example 2) which writes lora/latest.txt
# to blob storage for auto-discovery of the LoRA adapter.
#
# Variables use ${VAR:-default} so pre-existing shell values are preserved.
# Set AZURE_STORAGE_ACCOUNT_NAME before sourcing:
#   export AZURE_STORAGE_ACCOUNT_NAME="<prepared-storage-account>"

export RAY_IMAGE="${RAY_IMAGE:-mcr.microsoft.com/aks/ai-runtime/ray:py3.12-ray2.56.1-cuda13.0}"
export RAY_VERSION="${RAY_VERSION:-2.56.1}"

export JOB_NAME="${JOB_NAME:-batch-inference-$(date +%s)}"
export QUEUE_NAME="${QUEUE_NAME:-default}"
export CONFIGMAP_NAME="${CONFIGMAP_NAME:-batch-inference-scripts}"

# Storage prepared through the managed Module 1 setup.
export AZURE_STORAGE_ACCOUNT_NAME="${AZURE_STORAGE_ACCOUNT_NAME:-}"
export LLM_DATA_CONTAINER="${LLM_DATA_CONTAINER:-llm-pipeline}"
export LLM_LORA_CONTAINER="${LLM_LORA_CONTAINER:-llm-pipeline}"
